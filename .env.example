# Copy to .env (which is git-ignored) and fill in real values. Placeholders only; never commit
# real URLs, tenants, audiences or secrets to this repository.
#
# All settings are required. The server refuses to start if any is missing, and there are no
# built-in defaults.

# Base URL of the trackItsValue API that tool calls are passed through to.
MCPAPP__TIVAPIBASEURL=http://localhost:5000/tiv

# OAuth authorization server (Auth0 tenant) that issues the tokens this server accepts.
MCPAPP__STSAUTHORITY=https://your-tenant.auth0.com/

# This server's own public URL, including /mcp. It must match the identifier of the API registered
# for the MCP server at the authorization server; tokens for any other audience are rejected.
MCPAPP__STSAUDIENCE=http://localhost:5200/mcp

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5200
